<Project>
  <PropertyGroup>
    <OutDir>$(MSBuildThisFileDirectory)$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(MSBuildThisFileDirectory)$(Platform)\$(Configuration)\obj\$(MSBuildProjectName)\</IntDir>
    <TargetName Condition="'$(MSBuildProjectName)'=='cchp-api-dll'">cchp</TargetName>
  </PropertyGroup>
</Project>
